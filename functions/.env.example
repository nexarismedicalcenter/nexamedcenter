# Copy to .env.nexaris-1339d for the Firebase Functions runtime.
# Keep the Resend API key in Firebase Secret Manager, never in this file.
NEXA_EMAIL_FROM=
# Public Firebase Web Push VAPID key; not a private credential.
NEXA_WEB_PUSH_VAPID_KEY=

# Enable only after NEXA approves the health-data privacy notice and consent.
NEXA_MEDICAL_PROFILE_WRITES_ENABLED=false

# Keep false until Agora RTC join/leave notifications are configured and verified.
AGORA_RTC_EVENTS_ACTIVE=false
